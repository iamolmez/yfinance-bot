# Telegram bot token - @BotFather'dan alinir
# Ornek: 1234567890:AAH_abcDEFghijklmnoPQRstuvwxyz
BOT_TOKEN=

# Sadece bu kullanici id'leri botu kullanabilir (virgulle ayir)
# Kendi id'nizi ogrenmek icin bot'a /start yazmaniz yeterli
ALLOWED_USER_IDS=

# Veritabani dosyasi (bos birakilirsa finance.db olusur)
DB_PATH=

# Baz para birimi: TRY veya USD (portfoy toplami bu birimde gosterilir)
BASE_CURRENCY=TRY

# Kisa vadeli tarama icin gecmis veri periyodu
HISTORY_PERIOD=6mo

# Sinyal taramasi kac dakikada bir yapilsin
SCAN_MINUTES=60

# Fiyat alarmlari kac saniyede bir kontrol edilsin
ALERT_CHECK_SECONDS=180

# Ani hareket alarmi esigi (gunluk yuzde degisim)
BIG_MOVE_PCT=5.0
